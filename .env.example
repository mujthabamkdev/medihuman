# Optional local server port. No API keys are required for rule-based mode.
PORT=4173
# Persistence backend. Keep json for local-only development; use supabase in deployment.
STORE_BACKEND=json
# Durable backend data file. Keep outside publicly served assets in production.
DATA_FILE=./.data/medihuman.json
# Supabase project URL and server-only service-role key. Never expose service key to browser.
# SUPABASE_URL=https://hagplohwjudzbenftljk.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-me
# Supabase Auth publishable key used only by server-side auth proxy.
# SUPABASE_PUBLISHABLE_KEY=replace-me
# Public deployment origin used for confirmation/recovery links.
# MEDIHUMAN_PUBLIC_URL=http://localhost:4173
# 32-byte base64 key for encrypted upstream Supabase Auth session tokens.
# MEDIHUMAN_AUTH_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Optional names for the low-egress state table and CAS function.
# SUPABASE_STATE_TABLE=medihuman_state
# SUPABASE_STATE_RPC=medihuman_commit_state
# Set only for an intentional overwrite during local-state migration.
# SUPABASE_MIGRATE_OVERWRITE=1
# Server-only key for clinician verification operations. Never expose to browser.
# MEDIHUMAN_CLINICIAN_ADMIN_KEY=replace-me
# Optional OpenAI-compatible JSON summary endpoint. Keep credentials server-side.
# MEDIHUMAN_SUMMARY_URL=https://provider.example/v1/chat/completions
# MEDIHUMAN_SUMMARY_API_KEY=replace-me
# MEDIHUMAN_SUMMARY_MODEL=approved-model
# Explicit PHI summary opt-in and exact approved HTTPS host allowlist.
# MEDIHUMAN_SUMMARY_APPROVED_HOSTS=provider.example
# MEDIHUMAN_SUMMARY_ALLOW_PHI=0
# Optional Google OAuth 2.0 / OpenID Connect sign-in.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-host.example.com/api/auth/google/callback

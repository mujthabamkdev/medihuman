# Optional local server port. No API keys are required for rule-based mode.
PORT=4173
# Durable backend data file. Keep outside publicly served assets in production.
DATA_FILE=./.data/medihuman.json
# Optional OpenAI-compatible JSON summary endpoint. Keep credentials server-side.
# MEDIHUMAN_SUMMARY_URL=https://provider.example/v1/chat/completions
# MEDIHUMAN_SUMMARY_API_KEY=replace-me
# MEDIHUMAN_SUMMARY_MODEL=approved-model
# Optional Google OAuth 2.0 / OpenID Connect sign-in.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-host.example.com/api/auth/google/callback
